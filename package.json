{
  "name": "minu",
  "version": "1.1.0",
  "description": "Lightweight HTML fragment loader — fetch and inject content with zero dependencies",
  "main": "dist/minu.min.js",
  "module": "dist/minu.esm.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/minu.esm.js",
      "require": "./dist/minu.min.js"
    },
    "./secure": {
      "types": "./index.d.ts",
      "import": "./dist/minu.secure.esm.js",
      "require": "./dist/minu.secure.min.js"
    }
  },
  "files": [
    "dist/",
    "index.d.ts",
    "readme.md",
    "LICENSE"
  ],
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "examples": "npx serve ."
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotr/minu.git"
  },
  "keywords": [
    "dynamic-content",
    "fragment-loader",
    "dom-manipulation",
    "javascript-library",
    "markup-injection",
    "data-fetching",
    "event-dispatching",
    "web-applications",
    "ajax",
    "lightweight-js",
    "htmx-alternative",
    "html-fragment"
  ],
  "author": "Animesh Chakraborty",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aotr/minu/issues"
  },
  "homepage": "https://github.com/aotr/minu#readme",
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
