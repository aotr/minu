{
  "name": "minu",
  "version": "1.6.0",
  "description": "Lightweight HTML fragment loader — AJAX, polling, and live SSE content with zero dependencies",
  "main": "dist/minu.min.js",
  "module": "dist/minu.esm.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/minu.esm.mjs",
      "require": "./dist/minu.min.js"
    },
    "./secure": {
      "types": "./index.d.ts",
      "import": "./dist/minu.secure.esm.mjs",
      "require": "./dist/minu.secure.min.js"
    }
  },
  "files": [
    "dist/",
    "index.d.ts",
    "readme.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "test:only": "node --test \"test/**/*.test.js\"",
    "examples": "node example/server.js",
    "demo:live": "node example/server.js"
  },
  "peerDependencies": {
    "dompurify": ">=3"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotr/minu.git"
  },
  "keywords": [
    "dynamic-content",
    "fragment-loader",
    "dom-manipulation",
    "javascript-library",
    "markup-injection",
    "data-fetching",
    "event-dispatching",
    "web-applications",
    "ajax",
    "lightweight-js",
    "htmx-alternative",
    "html-fragment"
  ],
  "author": "Animesh Chakraborty",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aotr/minu/issues"
  },
  "homepage": "https://github.com/aotr/minu#readme",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite-plus": "^1.4.0"
  }
}
